# Copy this file to .env and fill in values for your own clone.
# Never commit .env or share its credentials.

DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
BRIEFING_OWNER_EMAIL=
TAVILY_API_KEY=
USER_CREDENTIALS_ENCRYPTION_KEY=

# Local Vite-to-API routing for a clone.
LOCAL_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional Qwen summaries; set true to allow per-account activation.
AI_FEATURE_ENABLED=false

# Optional: route Qwen summaries through Bifrost with FraudGuard loaded.
# Set BRIEF_AI_PROVIDER=bifrost only after Bifrost is reachable and the
# fraudguard .so is configured in that Bifrost server.
# Tavily search remains direct and is not routed through Bifrost.
# Remote Bifrost endpoints must use HTTPS. Never commit the virtual key.
# BRIEF_AI_PROVIDER=bifrost
# BIFROST_BASE_URL=https://your-bifrost-host
# BIFROST_MODEL=ollama/qwen3:0.6b
# BIFROST_VIRTUAL_KEY=
