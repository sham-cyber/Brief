# Copy this file to .env and fill in values for your own clone.
# Never commit .env or share its credentials.

DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
BRIEFING_OWNER_EMAIL=
TAVILY_API_KEY=
USER_CREDENTIALS_ENCRYPTION_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Local Vite-to-API routing for a clone.
LOCAL_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional Qwen/Ollama summaries; set true to allow per-account activation.
AI_FEATURE_ENABLED=false
