modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Workspace Ollama"

[[workflows.workflow]]
name = "Workspace Ollama"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "OLLAMA_HOST=127.0.0.1:11434 OLLAMA_CONTEXT_LENGTH=1024 OLLAMA_NUM_PARALLEL=1 ollama serve"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["ollama"]

[userenv]

[userenv.shared]
AI_FEATURE_ENABLED = "true"

[userenv.development]
OLLAMA_HOST = "http://127.0.0.1:11434"
OLLAMA_MODEL = "qwen3:0.6b"
